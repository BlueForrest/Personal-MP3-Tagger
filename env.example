# jstal-tagger V2.3 - copy this file to .env and fill in your own values.
# docker compose reads it automatically (docker compose up -d --build).

# ---- folders on the server --------------------------------------------------
# The music folder (mounted as /music in the container).
MUSIC_HOST_PATH=/srv/music
# V2.3: the video folder (mounted as /videos, shown as "Videos" in the page). MP4, M4A and
# M4V files there can be tagged like the MP3 files. Required by docker-compose.yml.
VIDEO_HOST_PATH=/srv/videos
# The backup folder, OUTSIDE the music and video folders (mounted as /backups). Every save / wipe
# puts a verified backup copy here first. The YouTube counter file also lives here
# (.jstal-tagger/youtube-quota.json).
BACKUP_HOST_PATH=/srv/jstal-tagger-backups

# ---- writing ------------------------------------------------------------------
# false = read-only (default). Writing needs BOTH: ENABLE_TAG_WRITES=true AND
# MUSIC_READ_ONLY=false (for Music) / VIDEO_READ_ONLY=false (for Videos, V2.3).
ENABLE_TAG_WRITES=false
MUSIC_READ_ONLY=true
VIDEO_READ_ONLY=true
# false (default): the backups of a save in which every file was saved and verified are
# removed afterwards. Wipe backups and saves with a failed file are always kept.
KEEP_BACKUPS=false

# ---- page -----------------------------------------------------------------------
# true (default): the page starts with "Edit tags" switched on (V2.1). Editing only makes
# drafts in the browser; nothing is written without Save tags and its confirmation.
EDIT_MODE_DEFAULT=true

# ---- online lookups -----------------------------------------------------------
# Required by MusicBrainz, LRCLIB and Megalobiz: application name, version and a real contact.
LOOKUP_USER_AGENT=jstal-tagger/2.3 (mailto:you@example.com)

# YouTube Data API v3 key (empty = YouTube lookup off).
YOUTUBE_API_KEY=
YOUTUBE_REGION=BE
# Channel names that are ranked higher, separated by |
YOUTUBE_PREFERRED_CHANNELS=
# Searches per day before the app refuses further YouTube lookups (V2.1). The free quota is
# 10 000 units a day and one search costs 100 units, so 100 is the practical maximum.
# Google resets the quota at midnight Pacific time (about 09:00 in Belgium).
YOUTUBE_DAILY_LIMIT=100

# Discogs personal access token (empty = Discogs lookup off).
DISCOGS_TOKEN=
# {"artist|title": master id} for songs Discogs matches wrongly (JSON, one line).
DISCOGS_MASTER_OVERRIDES=

# Megalobiz (synchronised lyrics, V2.1) works without a key: 30 requests a minute and
# 1000 a day. A free key (sign in on megalobiz.com, Developers API) raises that to 300 / 20 000.
MEGALOBIZ_API_KEY=
